[
  {
    "id": "N08-01-01",
    "startMs": 0,
    "endMs": 4600,
    "text": "深夜，一位程序员把尚未完成的功能交给 Agent：",
    "mergedFrom": [
      {
        "id": "N08-01-01",
        "startMs": 0,
        "endMs": 4600,
        "text": "深夜，一位程序员把尚未完成的功能交给 Agent："
      }
    ],
    "chapterId": "01"
  },
  {
    "id": "N08-01-02",
    "startMs": 4600,
    "endMs": 8400,
    "text": "编写代码、运行测试、整理文档。",
    "mergedFrom": [
      {
        "id": "N08-01-02",
        "startMs": 4600,
        "endMs": 8400,
        "text": "编写代码、运行测试、整理文档。"
      }
    ],
    "chapterId": "01"
  },
  {
    "id": "N08-01-03",
    "startMs": 8400,
    "endMs": 16000,
    "text": "随后关掉屏幕，等到第二天再进行验收。",
    "mergedFrom": [
      {
        "id": "N08-01-03",
        "startMs": 8400,
        "endMs": 16000,
        "text": "随后关掉屏幕，等到第二天再进行验收。"
      }
    ],
    "chapterId": "01"
  },
  {
    "id": "N08-01-04",
    "startMs": 16000,
    "endMs": 20400,
    "text": "从逐行写代码转向简单的“发送”“接受”，",
    "mergedFrom": [
      {
        "id": "N08-01-04",
        "startMs": 16000,
        "endMs": 20400,
        "text": "从逐行写代码转向简单的“发送”“接受”，"
      }
    ],
    "chapterId": "01"
  },
  {
    "id": "N08-01-05",
    "startMs": 20400,
    "endMs": 24000,
    "text": "他有机会更早合上电脑，下班回家。",
    "mergedFrom": [
      {
        "id": "N08-01-05",
        "startMs": 20400,
        "endMs": 24000,
        "text": "他有机会更早合上电脑，下班回家。"
      }
    ],
    "chapterId": "01"
  },
  {
    "id": "N08-01-06",
    "startMs": 24000,
    "endMs": 27800,
    "text": "然而他总想着多做一件事，",
    "mergedFrom": [
      {
        "id": "N08-01-06",
        "startMs": 24000,
        "endMs": 27800,
        "text": "然而他总想着多做一件事，"
      }
    ],
    "chapterId": "01"
  },
  {
    "id": "N08-01-07",
    "startMs": 27800,
    "endMs": 31600,
    "text": "或许是补一个单元测试，重启搁置的需求。",
    "mergedFrom": [
      {
        "id": "N08-01-07",
        "startMs": 27800,
        "endMs": 31600,
        "text": "或许是补一个单元测试，重启搁置的需求。"
      }
    ],
    "chapterId": "01"
  },
  {
    "id": "N08-01-08",
    "startMs": 31600,
    "endMs": 37400,
    "text": "他发现任务逐项完成，Todo list却不断延长。",
    "mergedFrom": [
      {
        "id": "N08-01-08",
        "startMs": 31600,
        "endMs": 37400,
        "text": "他发现任务逐项完成，Todo list却不断延长。"
      }
    ],
    "chapterId": "01"
  },
  {
    "id": "N08-01-09",
    "startMs": 37400,
    "endMs": 45000,
    "text": "为什么工具替人完成了更多任务，工作的终点反而越来越远？",
    "mergedFrom": [
      {
        "id": "N08-01-09",
        "startMs": 37400,
        "endMs": 45000,
        "text": "为什么工具替人完成了更多任务，工作的终点反而越来越远？"
      }
    ],
    "chapterId": "01"
  },
  {
    "id": "N08-02-01",
    "startMs": 45000,
    "endMs": 50100,
    "text": "在他的职业中，工作并非固定的存量。",
    "mergedFrom": [
      {
        "id": "N08-02-01",
        "startMs": 0,
        "endMs": 5100,
        "text": "在他的职业中，工作并非固定的存量。"
      }
    ],
    "chapterId": "02"
  },
  {
    "id": "N08-02-02",
    "startMs": 50100,
    "endMs": 55100,
    "text": "开发成本下降，会使项目的“成本-收益”边界移动，",
    "mergedFrom": [
      {
        "id": "N08-02-02",
        "startMs": 5100,
        "endMs": 10100,
        "text": "开发成本下降，会使项目的“成本-收益”边界移动，"
      }
    ],
    "chapterId": "02"
  },
  {
    "id": "N08-02-03",
    "startMs": 55100,
    "endMs": 59200,
    "text": "让部分需求的可行性逐渐提升。",
    "mergedFrom": [
      {
        "id": "N08-02-03",
        "startMs": 10100,
        "endMs": 14200,
        "text": "让部分需求的可行性逐渐提升。"
      }
    ],
    "chapterId": "02"
  },
  {
    "id": "N08-02-04",
    "startMs": 59200,
    "endMs": 66300,
    "text": "对他而言，工具带来的效率收益既可用于减少劳动时长，也可用于扩大产出。",
    "mergedFrom": [
      {
        "id": "N08-02-04",
        "startMs": 14200,
        "endMs": 21300,
        "text": "对他而言，工具带来的效率收益既可用于减少劳动时长，也可用于扩大产出。"
      }
    ],
    "chapterId": "02"
  },
  {
    "id": "N08-02-05",
    "startMs": 66300,
    "endMs": 72200,
    "text": "而价值增殖目的促使其将节约的成本重新投入生产。",
    "mergedFrom": [
      {
        "id": "N08-02-05",
        "startMs": 21300,
        "endMs": 27200,
        "text": "而价值增殖目的促使其将节约的成本重新投入生产。"
      }
    ],
    "chapterId": "02"
  },
  {
    "id": "N08-02-06",
    "startMs": 72200,
    "endMs": 77500,
    "text": "因此随着成本降低，他倾向于安排更多的任务，",
    "mergedFrom": [
      {
        "id": "N08-02-06",
        "startMs": 27200,
        "endMs": 32500,
        "text": "因此随着成本降低，他倾向于安排更多的任务，"
      }
    ],
    "chapterId": "02"
  },
  {
    "id": "N08-02-07",
    "startMs": 77500,
    "endMs": 83000,
    "text": "以维持总劳动投入的平衡。",
    "mergedFrom": [
      {
        "id": "N08-02-07",
        "startMs": 32500,
        "endMs": 38000,
        "text": "以维持总劳动投入的平衡。"
      }
    ],
    "chapterId": "02"
  },
  {
    "id": "N08-03-01",
    "startMs": 83000,
    "endMs": 87700,
    "text": "对企业而言，在以工时组织的雇佣劳动中，",
    "mergedFrom": [
      {
        "id": "N08-03-01",
        "startMs": 0,
        "endMs": 4700,
        "text": "对企业而言，在以工时组织的雇佣劳动中，"
      }
    ],
    "chapterId": "03"
  },
  {
    "id": "N08-03-02",
    "startMs": 87700,
    "endMs": 92600,
    "text": "劳动者让渡一定期限内的劳动力使用权以换取报酬。",
    "mergedFrom": [
      {
        "id": "N08-03-02",
        "startMs": 4700,
        "endMs": 9600,
        "text": "劳动者让渡一定期限内的劳动力使用权以换取报酬。"
      }
    ],
    "chapterId": "03"
  },
  {
    "id": "N08-03-03",
    "startMs": 92600,
    "endMs": 96300,
    "text": "即使他决定将清单提前清空，",
    "mergedFrom": [
      {
        "id": "N08-03-03",
        "startMs": 9600,
        "endMs": 13300,
        "text": "即使他决定将清单提前清空，"
      }
    ],
    "chapterId": "03"
  },
  {
    "id": "N08-03-04",
    "startMs": 96300,
    "endMs": 100000,
    "text": "在约定工时结束之前，",
    "mergedFrom": [
      {
        "id": "N08-03-04",
        "startMs": 13300,
        "endMs": 17000,
        "text": "在约定工时结束之前，"
      }
    ],
    "chapterId": "03"
  },
  {
    "id": "N08-03-05",
    "startMs": 100000,
    "endMs": 105000,
    "text": "企业仍能在约定时段分配其他任务。",
    "mergedFrom": [
      {
        "id": "N08-03-05",
        "startMs": 17000,
        "endMs": 22000,
        "text": "企业仍能在约定时段分配其他任务。"
      }
    ],
    "chapterId": "03"
  },
  {
    "id": "N08-03-06",
    "startMs": 105000,
    "endMs": 109200,
    "text": "Agent 工具前所未有地缩短了执行过程，",
    "mergedFrom": [
      {
        "id": "N08-03-06",
        "startMs": 22000,
        "endMs": 26200,
        "text": "Agent 工具前所未有地缩短了执行过程，"
      }
    ],
    "chapterId": "03"
  },
  {
    "id": "N08-03-07",
    "startMs": 109200,
    "endMs": 113500,
    "text": "却未必增大了劳动者对劳动时间的决定权。",
    "mergedFrom": [
      {
        "id": "N08-03-07",
        "startMs": 26200,
        "endMs": 30500,
        "text": "却未必增大了劳动者对劳动时间的决定权。"
      }
    ],
    "chapterId": "03"
  },
  {
    "id": "N08-03-08",
    "startMs": 113500,
    "endMs": 118100,
    "text": "在响应要求、任务标准和工时界限的约束下，",
    "mergedFrom": [
      {
        "id": "N08-03-08",
        "startMs": 30500,
        "endMs": 35100,
        "text": "在响应要求、任务标准和工时界限的约束下，"
      }
    ],
    "chapterId": "03"
  },
  {
    "id": "N08-03-09",
    "startMs": 118100,
    "endMs": 122000,
    "text": "劳动者自然无法决定劳动是否结束。",
    "mergedFrom": [
      {
        "id": "N08-03-09",
        "startMs": 35100,
        "endMs": 39000,
        "text": "劳动者自然无法决定劳动是否结束。"
      }
    ],
    "chapterId": "03"
  },
  {
    "id": "N08-04-01",
    "startMs": 122000,
    "endMs": 126300,
    "text": "对一家科技公司的调查称，",
    "mergedFrom": [
      {
        "id": "N08-04-01",
        "startMs": 0,
        "endMs": 4300,
        "text": "对一家科技公司的调查称，"
      }
    ],
    "chapterId": "04"
  },
  {
    "id": "N08-04-02",
    "startMs": 126300,
    "endMs": 130400,
    "text": "部分员工会主动扩大任务范围，",
    "mergedFrom": [
      {
        "id": "N08-04-02",
        "startMs": 4300,
        "endMs": 8400,
        "text": "部分员工会主动扩大任务范围，"
      }
    ],
    "chapterId": "04"
  },
  {
    "id": "N08-04-03",
    "startMs": 130400,
    "endMs": 136000,
    "text": "在午餐、会前和晚间等非工作时段向 Agent 交付任务。",
    "mergedFrom": [
      {
        "id": "N08-04-03",
        "startMs": 8400,
        "endMs": 14000,
        "text": "在午餐、会前和晚间等非工作时段向 Agent 交付任务。"
      }
    ],
    "chapterId": "04"
  },
  {
    "id": "N08-04-04",
    "startMs": 136000,
    "endMs": 140000,
    "text": "对于员工而言，新增能力带来更多产出，",
    "mergedFrom": [
      {
        "id": "N08-04-04",
        "startMs": 14000,
        "endMs": 18000,
        "text": "对于员工而言，新增能力带来更多产出，"
      }
    ],
    "chapterId": "04"
  },
  {
    "id": "N08-04-05",
    "startMs": 140000,
    "endMs": 143500,
    "text": "组织预期也随之提高。",
    "mergedFrom": [
      {
        "id": "N08-04-05",
        "startMs": 18000,
        "endMs": 21500,
        "text": "组织预期也随之提高。"
      }
    ],
    "chapterId": "04"
  },
  {
    "id": "N08-04-06",
    "startMs": 143500,
    "endMs": 148800,
    "text": "而在企业侧，竞争同样会强化采用新技术的压力：",
    "mergedFrom": [
      {
        "id": "N08-04-06",
        "startMs": 21500,
        "endMs": 26800,
        "text": "而在企业侧，竞争同样会强化采用新技术的压力："
      }
    ],
    "chapterId": "04"
  },
  {
    "id": "N08-04-07",
    "startMs": 148800,
    "endMs": 153800,
    "text": "Agent 普及后，原有的效率优势逐渐消退，",
    "mergedFrom": [
      {
        "id": "N08-04-07",
        "startMs": 26800,
        "endMs": 31800,
        "text": "Agent 普及后，原有的效率优势逐渐消退，"
      }
    ],
    "chapterId": "04"
  },
  {
    "id": "N08-04-08",
    "startMs": 153800,
    "endMs": 158000,
    "text": "企业仍有缩短周期、增加交付的动力。",
    "mergedFrom": [
      {
        "id": "N08-04-08",
        "startMs": 31800,
        "endMs": 36000,
        "text": "企业仍有缩短周期、增加交付的动力。"
      }
    ],
    "chapterId": "04"
  },
  {
    "id": "N08-04-09",
    "startMs": 158000,
    "endMs": 162400,
    "text": "企业同样会促使更高产出进入排期和考核，",
    "mergedFrom": [
      {
        "id": "N08-04-09",
        "startMs": 36000,
        "endMs": 40400,
        "text": "企业同样会促使更高产出进入排期和考核，"
      }
    ],
    "chapterId": "04"
  },
  {
    "id": "N08-04-10",
    "startMs": 162400,
    "endMs": 166600,
    "text": "使原本的额外贡献转为新的基准。",
    "mergedFrom": [
      {
        "id": "N08-04-10",
        "startMs": 40400,
        "endMs": 44600,
        "text": "使原本的额外贡献转为新的基准。"
      }
    ],
    "chapterId": "04"
  },
  {
    "id": "N08-04-11",
    "startMs": 166600,
    "endMs": 172600,
    "text": "因此：Agent 带来的普遍生产力提升造成了工作标准的提升，",
    "mergedFrom": [
      {
        "id": "N08-04-11",
        "startMs": 44600,
        "endMs": 50600,
        "text": "因此：Agent 带来的普遍生产力提升造成了工作标准的提升，"
      }
    ],
    "chapterId": "04"
  },
  {
    "id": "N08-04-12",
    "startMs": 172600,
    "endMs": 177000,
    "text": "从“能多做”，到“必须做”。",
    "mergedFrom": [
      {
        "id": "N08-04-12",
        "startMs": 50600,
        "endMs": 55000,
        "text": "从“能多做”，到“必须做”。"
      }
    ],
    "chapterId": "04"
  },
  {
    "id": "N08-05-01",
    "startMs": 177400,
    "endMs": 184000,
    "text": "调度多个 Agent 可能会让员工产生指挥“虚拟员工”的错觉，",
    "mergedFrom": [
      {
        "id": "N08-05-01",
        "startMs": 400,
        "endMs": 7000,
        "text": "调度多个 Agent 可能会让员工产生指挥“虚拟员工”的错觉，"
      }
    ],
    "chapterId": "05"
  },
  {
    "id": "N08-05-02",
    "startMs": 184000,
    "endMs": 189800,
    "text": "却未必会赋予任何雇主的决定权或分享额外收益的权力；",
    "mergedFrom": [
      {
        "id": "N08-05-02",
        "startMs": 7000,
        "endMs": 12800,
        "text": "却未必会赋予任何雇主的决定权或分享额外收益的权力；"
      }
    ],
    "chapterId": "05"
  },
  {
    "id": "N08-05-03",
    "startMs": 189800,
    "endMs": 195500,
    "text": "这些“虚拟员工”反而会要求员工付出更多的成本，",
    "mergedFrom": [
      {
        "id": "N08-05-03",
        "startMs": 12800,
        "endMs": 18500,
        "text": "这些“虚拟员工”反而会要求员工付出更多的成本，"
      }
    ],
    "chapterId": "05"
  },
  {
    "id": "N08-05-04",
    "startMs": 195500,
    "endMs": 198700,
    "text": "甚至是额外的时间和金钱，",
    "mergedFrom": [
      {
        "id": "N08-05-04",
        "startMs": 18500,
        "endMs": 21700,
        "text": "甚至是额外的时间和金钱，"
      }
    ],
    "chapterId": "05"
  },
  {
    "id": "N08-05-05",
    "startMs": 198700,
    "endMs": 203800,
    "text": "以维持自己作为“虚拟雇主”的生产力优势。",
    "mergedFrom": [
      {
        "id": "N08-05-05",
        "startMs": 21700,
        "endMs": 26800,
        "text": "以维持自己作为“虚拟雇主”的生产力优势。"
      }
    ],
    "chapterId": "05"
  },
  {
    "id": "N08-05-06",
    "startMs": 203800,
    "endMs": 209500,
    "text": "社会劳动创造的生产力，在特定的占有和组织关系中，",
    "mergedFrom": [
      {
        "id": "N08-05-06",
        "startMs": 26800,
        "endMs": 32500,
        "text": "社会劳动创造的生产力，在特定的占有和组织关系中，"
      }
    ],
    "chapterId": "05"
  },
  {
    "id": "N08-05-07",
    "startMs": 209500,
    "endMs": 214000,
    "text": "反而会成为约束劳动者的外在力量。",
    "mergedFrom": [
      {
        "id": "N08-05-07",
        "startMs": 32500,
        "endMs": 37000,
        "text": "反而会成为约束劳动者的外在力量。"
      }
    ],
    "chapterId": "05"
  },
  {
    "id": "N08-05-08",
    "startMs": 214000,
    "endMs": 216500,
    "text": "这是劳动异化的一个侧面：",
    "mergedFrom": [
      {
        "id": "N08-05-08",
        "startMs": 37000,
        "endMs": 39500,
        "text": "这是劳动异化的一个侧面："
      }
    ],
    "chapterId": "05"
  },
  {
    "id": "N08-05-09",
    "startMs": 216500,
    "endMs": 219000,
    "text": "具体的指令由劳动者发出，",
    "mergedFrom": [
      {
        "id": "N08-05-09",
        "startMs": 39500,
        "endMs": 42000,
        "text": "具体的指令由劳动者发出，"
      }
    ],
    "chapterId": "05"
  },
  {
    "id": "N08-05-10",
    "startMs": 219000,
    "endMs": 222000,
    "text": "而劳动的目的与尺度仍可能由他人设定。",
    "mergedFrom": [
      {
        "id": "N08-05-10",
        "startMs": 42000,
        "endMs": 45000,
        "text": "而劳动的目的与尺度仍可能由他人设定。"
      }
    ],
    "chapterId": "05"
  },
  {
    "id": "N08-06-01",
    "startMs": 222400,
    "endMs": 226600,
    "text": "效率收益可以转化为更多交付，",
    "mergedFrom": [
      {
        "id": "N08-06-01",
        "startMs": 400,
        "endMs": 4600,
        "text": "效率收益可以转化为更多交付，"
      }
    ],
    "chapterId": "06"
  },
