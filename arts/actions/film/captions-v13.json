    ],
    "chapterId": "02",
    "sentenceId": "S13-02-01",
    "sourceStartMs": 45000,
    "sourceEndMs": 50100
  },
  {
    "id": "N08-02-02",
    "startMs": 38833,
    "endMs": 43167,
    "text": "开发成本下降，会使项目的“成本-收益”边界移动，",
    "mergedFrom": [
      {
        "id": "N08-02-02",
        "startMs": 5100,
        "endMs": 10100,
        "text": "开发成本下降，会使项目的“成本-收益”边界移动，"
      }
    ],
    "chapterId": "02",
    "sentenceId": "S13-02-02",
    "sourceStartMs": 50100,
    "sourceEndMs": 55100
  },
  {
    "id": "N08-02-03",
    "startMs": 43167,
    "endMs": 46033,
    "text": "让部分需求的可行性逐渐提升。",
    "mergedFrom": [
      {
        "id": "N08-02-03",
        "startMs": 10100,
        "endMs": 14200,
        "text": "让部分需求的可行性逐渐提升。"
      }
    ],
    "chapterId": "02",
    "sentenceId": "S13-02-02",
    "sourceStartMs": 55100,
    "sourceEndMs": 59200
  },
  {
    "id": "N08-02-04",
    "startMs": 46533,
    "endMs": 53100,
    "text": "对他而言，工具带来的效率收益既可用于减少劳动时长，也可用于扩大产出。",
    "mergedFrom": [
      {
        "id": "N08-02-04",
        "startMs": 14200,
        "endMs": 21300,
        "text": "对他而言，工具带来的效率收益既可用于减少劳动时长，也可用于扩大产出。"
      }
    ],
    "chapterId": "02",
    "sentenceId": "S13-02-03",
    "sourceStartMs": 59200,
    "sourceEndMs": 66300
  },
  {
    "id": "N08-02-05",
    "startMs": 53600,
    "endMs": 58633,
    "text": "而价值增殖目的促使其将节约的成本重新投入生产。",
    "mergedFrom": [
      {
        "id": "N08-02-05",
        "startMs": 21300,
        "endMs": 27200,
        "text": "而价值增殖目的促使其将节约的成本重新投入生产。"
      }
    ],
    "chapterId": "02",
    "sentenceId": "S13-02-04",
    "sourceStartMs": 66300,
    "sourceEndMs": 72200
  },
  {
    "id": "N08-02-06",
    "startMs": 59133,
    "endMs": 63333,
    "text": "因此随着成本降低，他倾向于安排更多的任务，",
    "mergedFrom": [
      {
        "id": "N08-02-06",
        "startMs": 27200,
        "endMs": 32500,
        "text": "因此随着成本降低，他倾向于安排更多的任务，"
      }
