    "sourceStartMs": 27800,
    "sourceEndMs": 31600
  },
  {
    "id": "N08-01-08",
    "startMs": 24567,
    "endMs": 28800,
    "text": "他发现任务逐项完成，Todo list却不断延长。",
    "mergedFrom": [
      {
