    "sourceStartMs": 31600,
    "sourceEndMs": 37400
  },
  {
    "id": "N08-01-09",
    "startMs": 29300,
    "endMs": 34533,
    "text": "为什么工具替人完成了更多任务，工作的终点反而越来越远？",
    "mergedFrom": [
      {
        "id": "N08-01-09",
        "startMs": 37400,
        "endMs": 45000,
        "text": "为什么工具替人完成了更多任务，工作的终点反而越来越远？"
      }
    ],
    "chapterId": "01",
    "sentenceId": "S13-01-06",
    "sourceStartMs": 37400,
    "sourceEndMs": 45000
  },
  {
    "id": "N08-02-01",
    "startMs": 35200,
    "endMs": 38333,
    "text": "在他的职业中，工作并非固定的存量。",
    "mergedFrom": [
      {
        "id": "N08-02-01",
        "startMs": 0,
        "endMs": 5100,
        "text": "在他的职业中，工作并非固定的存量。"
