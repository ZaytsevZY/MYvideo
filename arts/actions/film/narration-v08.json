  "cues": {
    "01": [
      {
        "id": "N08-01-01",
        "startMs": 0,
        "endMs": 4600,
        "text": "深夜，一位程序员把尚未完成的功能交给 Agent："
      },
      {
        "id": "N08-01-02",
        "startMs": 4600,
        "endMs": 8400,
        "text": "编写代码、运行测试、整理文档。"
      },
      {
        "id": "N08-01-03",
        "startMs": 8400,
        "endMs": 16000,
        "text": "随后关掉屏幕，等到第二天再进行验收。"
      },
      {
        "id": "N08-01-04",
        "startMs": 16000,
        "endMs": 20400,
        "text": "从逐行写代码转向简单的“发送”“接受”，"
      },
      {
        "id": "N08-01-05",
        "startMs": 20400,
        "endMs": 24000,
        "text": "他有机会更早合上电脑，下班回家。"
      },
      {
        "id": "N08-01-06",
        "startMs": 24000,
        "endMs": 27800,
        "text": "然而他总想着多做一件事，"
      },
      {
        "id": "N08-01-07",
        "startMs": 27800,
        "endMs": 31600,
        "text": "或许是补一个单元测试，重启搁置的需求。"
      },
      {
        "id": "N08-01-08",
        "startMs": 31600,
        "endMs": 37400,
        "text": "他发现任务逐项完成，Todo list却不断延长。"
      },
      {
        "id": "N08-01-09",
        "startMs": 37400,
        "endMs": 45000,
        "text": "为什么工具替人完成了更多任务，工作的终点反而越来越远？"
      }
    ],
    "02": [
      {
        "id": "N08-02-01",
        "startMs": 0,
        "endMs": 5100,
        "text": "在他的职业中，工作并非固定的存量。"
      },
      {
        "id": "N08-02-02",
        "startMs": 5100,
        "endMs": 10100,
        "text": "开发成本下降，会使项目的“成本-收益”边界移动，"
      },
      {
        "id": "N08-02-03",
        "startMs": 10100,
        "endMs": 14200,
        "text": "让部分需求的可行性逐渐提升。"
      },
      {
        "id": "N08-02-04",
        "startMs": 14200,
        "endMs": 21300,
        "text": "对他而言，工具带来的效率收益既可用于减少劳动时长，也可用于扩大产出。"
      },
      {
        "id": "N08-02-05",
        "startMs": 21300,
        "endMs": 27200,
        "text": "而价值增殖目的促使其将节约的成本重新投入生产。"
      },
      {
        "id": "N08-02-06",
        "startMs": 27200,
        "endMs": 32500,
        "text": "因此随着成本降低，他倾向于安排更多的任务，"
      },
      {
        "id": "N08-02-07",
        "startMs": 32500,
        "endMs": 38000,
        "text": "以维持总劳动投入的平衡。"
      }
    ],
    "03": [
      {
        "id": "N08-03-01",
        "startMs": 0,
        "endMs": 4700,
        "text": "对企业而言，在以工时组织的雇佣劳动中，"
      },
      {
        "id": "N08-03-02",
        "startMs": 4700,
        "endMs": 9600,
        "text": "劳动者让渡一定期限内的劳动力使用权以换取报酬。"
      },
      {
        "id": "N08-03-03",
        "startMs": 9600,
        "endMs": 13300,
        "text": "即使他决定将清单提前清空，"
      },
      {
        "id": "N08-03-04",
        "startMs": 13300,
        "endMs": 17000,
        "text": "在约定工时结束之前，"
      },
      {
        "id": "N08-03-05",
        "startMs": 17000,
        "endMs": 22000,
        "text": "企业仍能在约定时段分配其他任务。"
      },
      {
        "id": "N08-03-06",
        "startMs": 22000,
        "endMs": 26200,
        "text": "Agent 工具前所未有地缩短了执行过程，"
      },
      {
        "id": "N08-03-07",
        "startMs": 26200,
        "endMs": 30500,
        "text": "却未必增大了劳动者对劳动时间的决定权。"
      },
      {
        "id": "N08-03-08",
        "startMs": 30500,
        "endMs": 35100,
        "text": "在响应要求、任务标准和工时界限的约束下，"
      },
      {
        "id": "N08-03-09",
        "startMs": 35100,
        "endMs": 39000,
        "text": "劳动者自然无法决定劳动是否结束。"
      }
    ],
    "04": [
      {
        "id": "N08-04-01",
        "startMs": 0,
        "endMs": 4300,
        "text": "对一家科技公司的调查称，"
      },
      {
        "id": "N08-04-02",
        "startMs": 4300,
        "endMs": 8400,
        "text": "部分员工会主动扩大任务范围，"
      },
      {
        "id": "N08-04-03",
        "startMs": 8400,
        "endMs": 14000,
        "text": "在午餐、会前和晚间等非工作时段向 Agent 交付任务。"
      },
      {
        "id": "N08-04-04",
        "startMs": 14000,
        "endMs": 18000,
        "text": "对于员工而言，新增能力带来更多产出，"
      },
      {
        "id": "N08-04-05",
        "startMs": 18000,
        "endMs": 21500,
        "text": "组织预期也随之提高。"
      },
      {
        "id": "N08-04-06",
        "startMs": 21500,
        "endMs": 26800,
        "text": "而在企业侧，竞争同样会强化采用新技术的压力："
      },
      {
        "id": "N08-04-07",
        "startMs": 26800,
        "endMs": 31800,
        "text": "Agent 普及后，原有的效率优势逐渐消退，"
      },
      {
        "id": "N08-04-08",
        "startMs": 31800,
        "endMs": 36000,
        "text": "企业仍有缩短周期、增加交付的动力。"
      },
      {
        "id": "N08-04-09",
        "startMs": 36000,
        "endMs": 40400,
        "text": "企业同样会促使更高产出进入排期和考核，"
      },
      {
        "id": "N08-04-10",
        "startMs": 40400,
        "endMs": 44600,
        "text": "使原本的额外贡献转为新的基准。"
      },
      {
        "id": "N08-04-11",
        "startMs": 44600,
        "endMs": 50600,
        "text": "因此：Agent 带来的普遍生产力提升造成了工作标准的提升，"
      },
      {
        "id": "N08-04-12",
        "startMs": 50600,
        "endMs": 55000,
        "text": "从“能多做”，到“必须做”。"
      }
    ],
    "05": [
      {
        "id": "N08-05-01",
        "startMs": 400,
        "endMs": 7000,
        "text": "调度多个 Agent 可能会让员工产生指挥“虚拟员工”的错觉，"
      },
      {
        "id": "N08-05-02",
        "startMs": 7000,
        "endMs": 12800,
        "text": "却未必会赋予任何雇主的决定权或分享额外收益的权力；"
      },
      {
        "id": "N08-05-03",
        "startMs": 12800,
        "endMs": 18500,
        "text": "这些“虚拟员工”反而会要求员工付出更多的成本，"
      },
      {
        "id": "N08-05-04",
        "startMs": 18500,
        "endMs": 21700,
        "text": "甚至是额外的时间和金钱，"
      },
      {
        "id": "N08-05-05",
        "startMs": 21700,
        "endMs": 26800,
        "text": "以维持自己作为“虚拟雇主”的生产力优势。"
      },
      {
        "id": "N08-05-06",
        "startMs": 26800,
        "endMs": 32500,
        "text": "社会劳动创造的生产力，在特定的占有和组织关系中，"
      },
      {
        "id": "N08-05-07",
        "startMs": 32500,
        "endMs": 37000,
        "text": "反而会成为约束劳动者的外在力量。"
      },
      {
        "id": "N08-05-08",
        "startMs": 37000,
        "endMs": 39500,
        "text": "这是劳动异化的一个侧面："
      },
      {
        "id": "N08-05-09",
        "startMs": 39500,
        "endMs": 42000,
        "text": "具体的指令由劳动者发出，"
      },
      {
        "id": "N08-05-10",
        "startMs": 42000,
        "endMs": 45000,
        "text": "而劳动的目的与尺度仍可能由他人设定。"
      }
    ],
    "06": [
      {
        "id": "N08-06-01",
        "startMs": 400,
        "endMs": 4600,
        "text": "效率收益可以转化为更多交付，"
      },
      {
        "id": "N08-06-02",
        "startMs": 4600,
        "endMs": 8800,
        "text": "也可以转化为更短工时。"
      },
      {
        "id": "N08-06-03",
        "startMs": 8800,
        "endMs": 16000,
        "text": "区别在于谁决定生产规模，谁分配节约的时间。"
      },
      {
        "id": "N08-06-04",
        "startMs": 16000,
        "endMs": 21500,
        "text": "让劳动者参与确定任务边界，"
      },
      {
        "id": "N08-06-05",
        "startMs": 21500,
        "endMs": 27000,
        "text": "并获得实际可支配的时间，"
      },
      {
        "id": "N08-06-06",
        "startMs": 27000,
        "endMs": 31000,
        "text": "技术进步才有机会转化为人的自由。"
      },
      {
        "id": "N08-06-07",
        "startMs": 31000,
        "endMs": 44000,
        "text": "效率何时成为义务，取决于谁有权为工作画上句号。"
      }
    ]
  }
}
