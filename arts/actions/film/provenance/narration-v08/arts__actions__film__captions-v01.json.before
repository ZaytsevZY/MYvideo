    "endMs": 198800,
    "sourceNote": "05-1",
    "mergedFrom": [
      {
        "startMs": 16300,
        "endMs": 19000,
        "text": "拒绝额外任务",
        "id": "S05-A06"
      },
      {
        "startMs": 19000,
        "endMs": 21800,
        "text": "或分享效率收益的权力。",
        "id": "S05-A07"
      }
    ],
    "chapterId": "05"
  },
  {
    "id": "S05-A08",
    "text": "社会劳动创造的生产力，",
    "startMs": 198800,
    "endMs": 202600,
    "sourceNote": "05-2",
    "mergedFrom": [
      {
        "startMs": 21800,
        "endMs": 25600,
        "text": "社会劳动创造的生产力，",
        "id": "S05-A08"
      }
    ],
    "chapterId": "05"
  },
  {
    "id": "S05-A09",
    "text": "在特定的占有和组织关系中，",
    "startMs": 202600,
    "endMs": 206400,
    "sourceNote": "05-2",
    "mergedFrom": [
      {
        "startMs": 25600,
        "endMs": 29400,
        "text": "在特定的占有和组织关系中，",
        "id": "S05-A09"
      }
    ],
    "chapterId": "05"
  },
  {
    "id": "S05-A10",
    "text": "反而会成为约束劳动者的外在力量。",
    "startMs": 206400,
    "endMs": 210800,
    "sourceNote": "05-2",
    "mergedFrom": [
      {
        "startMs": 29400,
        "endMs": 33800,
        "text": "反而会成为约束劳动者的外在力量。",
        "id": "S05-A10"
      }
    ],
    "chapterId": "05"
  },
  {
    "id": "S05-A11",
    "text": "这是劳动异化的一个侧面：",
    "startMs": 210800,
    "endMs": 214400,
    "sourceNote": "05-3",
    "mergedFrom": [
      {
        "startMs": 33800,
        "endMs": 37400,
        "text": "这是劳动异化的一个侧面：",
        "id": "S05-A11"
      }
    ],
    "chapterId": "05"
  },
  {
    "id": "S05-A12",
    "text": "具体的指令由人发出，",
    "startMs": 214400,
    "endMs": 217600,
    "sourceNote": "05-3",
    "mergedFrom": [
      {
        "startMs": 37400,
        "endMs": 40600,
        "text": "具体的指令由人发出，",
        "id": "S05-A12"
      }
    ],
    "chapterId": "05"
  },
  {
    "id": "S05-A13",
    "text": "而劳动的目的与尺度仍可能由他人设定。",
    "startMs": 217600,
    "endMs": 222000,
    "sourceNote": "05-3",
    "mergedFrom": [
      {
        "startMs": 40600,
        "endMs": 45000,
        "text": "而劳动的目的与尺度仍可能由他人设定。",
        "id": "S05-A13"
      }
    ],
    "chapterId": "05"
  },
  {
    "text": "效率收益可以转化为更多交付，",
    "startMs": 222000,
    "endMs": 226700,
    "timestampMs": null,
    "confidence": null,
    "id": "S06-A01",
    "sourceNote": "06-1",
    "mergedFrom": [
      {
        "startMs": 0,
        "endMs": 4700,
        "text": "效率收益可以转化为更多交付，",
        "id": "S06-A01"
      }
    ],
    "chapterId": "06"
  },
  {
    "text": "也可以转化为更短工时。",
    "startMs": 226700,
    "endMs": 230800,
    "timestampMs": null,
    "confidence": null,
    "id": "S06-A02",
    "sourceNote": "06-1",
    "mergedFrom": [
      {
        "startMs": 4700,
        "endMs": 8800,
        "text": "也可以转化为更短工时。",
        "id": "S06-A02"
      }
    ],
    "chapterId": "06"
  },
  {
    "text": "区别在于谁决定生产规模，谁分配节约的时间。",
    "startMs": 230800,
    "endMs": 238000,
    "timestampMs": null,
    "confidence": null,
    "id": "S06-A03",
    "sourceNote": "06-1",
    "mergedFrom": [
      {
        "startMs": 8800,
        "endMs": 12400,
        "text": "区别在于谁决定生产规模，",
        "id": "S06-A03"
      },
      {
        "startMs": 12400,
        "endMs": 16000,
        "text": "谁分配节约的时间。",
        "id": "S06-A04"
      }
    ],
    "chapterId": "06"
  },
  {
    "text": "让劳动者参与确定任务边界，",
    "startMs": 238000,
    "endMs": 243300,
    "timestampMs": null,
    "confidence": null,
    "id": "S06-A05",
    "sourceNote": "06-2",
    "mergedFrom": [
      {
        "startMs": 16000,
        "endMs": 21300,
        "text": "让劳动者参与确定任务边界，",
        "id": "S06-A05"
      }
    ],
    "chapterId": "06"
  },
  {
    "text": "并获得实际可支配的时间，",
    "startMs": 243300,
    "endMs": 248000,
    "timestampMs": null,
    "confidence": null,
    "id": "S06-A06",
    "sourceNote": "06-2",
    "mergedFrom": [
      {
        "startMs": 21300,
        "endMs": 26000,
        "text": "并获得实际可支配的时间，",
        "id": "S06-A06"
      }
    ],
    "chapterId": "06"
  },
  {
    "text": "技术进步才有机会转化为人的自由。",
    "startMs": 248000,
    "endMs": 253000,
    "timestampMs": null,
    "confidence": null,
    "id": "S06-A07",
    "sourceNote": "06-2",
    "mergedFrom": [
      {
        "startMs": 26000,
        "endMs": 31000,
        "text": "技术进步才有机会转化为人的自由。",
        "id": "S06-A07"
      }
    ],
    "chapterId": "06"
  },
  {
    "text": "效率何时成为义务，取决于谁有权为工作画上句号。",
    "startMs": 253000,
    "endMs": 266000,
    "timestampMs": null,
    "confidence": null,
