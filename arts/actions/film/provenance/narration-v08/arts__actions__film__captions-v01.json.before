  },
  {
    "text": "工具替人完成了更多任务，",
    "startMs": 37000,
    "endMs": 41000,
    "timestampMs": null,
    "confidence": null,
    "mergedFrom": [
      {
        "startMs": 37000,
        "endMs": 41000,
        "text": "工具替人完成了更多任务，",
        "id": null
      }
    ],
    "chapterId": "01"
  },
  {
    "text": "为什么工作的终点反而越来越远？",
    "startMs": 41000,
    "endMs": 45000,
    "timestampMs": null,
    "confidence": null,
    "mergedFrom": [
      {
        "startMs": 41000,
        "endMs": 45000,
        "text": "为什么工作的终点反而越来越远？",
        "id": null
      }
    ],
    "chapterId": "01"
  },
  {
    "text": "工作量不是固定的存量。",
    "startMs": 45000,
    "endMs": 47400,
    "timestampMs": null,
    "confidence": null,
    "mergedFrom": [
      {
        "startMs": 0,
        "endMs": 2400,
        "text": "工作量不是固定的存量。",
        "id": null
      }
    ],
    "chapterId": "02"
  },
  {
    "text": "开发成本下降，会改变项目的成本收益边界，",
    "startMs": 47400,
    "endMs": 53000,
    "timestampMs": null,
    "confidence": null,
    "mergedFrom": [
      {
        "startMs": 2400,
        "endMs": 5200,
        "text": "开发成本下降，",
        "id": null
      },
      {
        "startMs": 5200,
        "endMs": 8000,
        "text": "会改变项目的成本收益边界，",
        "id": null
      }
    ],
    "chapterId": "02"
  },
  {
    "text": "使一部分原先不值得开展的需求变得可行。",
    "startMs": 53000,
    "endMs": 58000,
    "timestampMs": null,
    "confidence": null,
    "mergedFrom": [
      {
        "startMs": 8000,
        "endMs": 10300,
        "text": "使一部分原先不值得开展的需求",
        "id": null
      },
      {
        "startMs": 10300,
        "endMs": 13000,
        "text": "变得可行。",
        "id": null
      }
    ],
    "chapterId": "02"
  },
  {
    "text": "效率收益既可用于减少劳动，也可用于扩大产出。",
    "startMs": 58000,
    "endMs": 64200,
    "timestampMs": null,
    "confidence": null,
    "mergedFrom": [
      {
        "startMs": 13000,
        "endMs": 16400,
        "text": "效率收益既可用于减少劳动，",
        "id": null
      },
      {
        "startMs": 16400,
        "endMs": 19200,
        "text": "也可用于扩大产出。",
        "id": null
      }
    ],
    "chapterId": "02"
  },
  {
    "text": "以价值增殖为目的的生产，",
    "startMs": 64200,
    "endMs": 67700,
    "timestampMs": null,
    "confidence": null,
    "mergedFrom": [
      {
        "startMs": 19200,
        "endMs": 22700,
        "text": "以价值增殖为目的的生产，",
        "id": null
      }
    ],
    "chapterId": "02"
  },
  {
    "text": "有将节约重新投入生产的动力。",
    "startMs": 67700,
    "endMs": 72000,
    "timestampMs": null,
    "confidence": null,
    "mergedFrom": [
      {
        "startMs": 22700,
        "endMs": 27000,
        "text": "有将节约重新投入生产的动力。",
        "id": null
      }
    ],
    "chapterId": "02"
  },
  {
    "text": "单项任务耗时缩短，总劳动投入仍取决于任务规模。",
    "startMs": 72000,
    "endMs": 83000,
    "timestampMs": null,
    "confidence": null,
    "mergedFrom": [
      {
        "startMs": 27000,
        "endMs": 30900,
        "text": "单项任务耗时缩短，",
        "id": null
      },
      {
        "startMs": 30900,
        "endMs": 38000,
        "text": "总劳动投入仍取决于任务规模。",
        "id": null
      }
    ],
    "chapterId": "02"
  },
  {
    "text": "在以工时组织的雇佣劳动中，",
    "startMs": 83000,
    "endMs": 87400,
    "timestampMs": null,
    "confidence": null,
    "mergedFrom": [
      {
        "startMs": 0,
        "endMs": 4400,
        "text": "在以工时组织的雇佣劳动中，",
        "id": null
      }
    ],
    "chapterId": "03"
  },
  {
    "text": "劳动者让渡的是一定期限内的劳动力使用权。",
    "startMs": 87400,
    "endMs": 92100,
    "timestampMs": null,
    "confidence": null,
    "mergedFrom": [
      {
        "startMs": 4400,
        "endMs": 9100,
        "text": "劳动者让渡的是一定期限内的劳动力使用权。",
        "id": null
      }
    ],
    "chapterId": "03"
  },
  {
    "text": "清单提前清空，约定工时不会因此自动结束。",
    "startMs": 92100,
    "endMs": 96000,
    "timestampMs": null,
    "confidence": null,
    "mergedFrom": [
      {
        "startMs": 9100,
        "endMs": 13000,
        "text": "清单提前清空，约定工时不会因此自动结束。",
        "id": null
      }
    ],
    "chapterId": "03"
  },
  {
    "text": "企业仍能在约定时段分配其他任务。",
    "startMs": 96000,
    "endMs": 100600,
    "timestampMs": null,
    "confidence": null,
    "mergedFrom": [
      {
        "startMs": 13000,
        "endMs": 17600,
        "text": "企业仍能在约定时段分配其他任务。",
        "id": null
      }
    ],
    "chapterId": "03"
  },
  {
    "text": "工作能否真正结束，还受响应要求、",
    "startMs": 100600,
    "endMs": 104500,
    "timestampMs": null,
    "confidence": null,
    "mergedFrom": [
      {
        "startMs": 17600,
        "endMs": 21500,
        "text": "工作能否真正结束，还受响应要求、",
        "id": null
      }
    ],
    "chapterId": "03"
  },
  {
    "text": "任务标准和工时界限的约束。",
    "startMs": 104500,
    "endMs": 108700,
    "timestampMs": null,
    "confidence": null,
    "mergedFrom": [
      {
        "startMs": 21500,
        "endMs": 25700,
        "text": "任务标准和工时界限的约束。",
        "id": null
      }
    ],
    "chapterId": "03"
  },
  {
    "text": "技术缩短了执行过程，",
    "startMs": 108700,
    "endMs": 113500,
    "timestampMs": null,
    "confidence": null,
    "mergedFrom": [
      {
        "startMs": 25700,
        "endMs": 30500,
        "text": "技术缩短了执行过程，",
        "id": null
      }
    ],
    "chapterId": "03"
  },
  {
    "text": "劳动者对劳动时间的决定权未必同步扩大。",
    "startMs": 113500,
    "endMs": 122000,
    "timestampMs": null,
    "confidence": null,
    "mergedFrom": [
      {
        "startMs": 30500,
        "endMs": 34700,
