<!doctype html><meta charset="utf-8"><title>第04章｜55秒无声字幕预览</title><style>body{margin:0;background:#152330;color:white;font:16px sans-serif}#screen{width:100%;aspect-ratio:16/9}svg{width:100%;height:100%}footer{padding:12px;display:flex;gap:20px;align-items:center}input{flex:1}</style><div id="screen"></div><footer><button id="play">播放</button><input type="range" id="seek" min="0" max="54.966667" step="0.033333" value="0"><span id="time">0.00 / 55.00</span></footer><script type="module">import {svg,assets} from './scene.mjs';const refs=Object.fromEntries(Object.entries(assets).map(([k,v])=>[k,'../../../'+v]));let playing=false,t=0,last;const draw=()=>{document.querySelector('#screen').innerHTML=svg(t,refs);document.querySelector('#seek').value=t;document.querySelector('#time').textContent=t.toFixed(2)+' / 55.00'};document.querySelector('#play').onclick=()=>{playing=!playing;last=performance.now();document.querySelector('#play').textContent=playing?'暂停':'播放'};document.querySelector('#seek').oninput=e=>{t=+e.target.value;draw()};function tick(now){if(playing){t+=(now-last)/1000;if(t>=55){t=0;playing=false}draw()}last=now;requestAnimationFrame(tick)}draw();requestAnimationFrame(tick);</script>